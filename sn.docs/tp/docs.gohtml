{{define "nav"}}
{{- $items := split "index|Overview,getting-started|Getting Started,api-reference|API Reference,lua-api|Lua API,cli-reference|CLI Reference,configuration-guide|Configuration Guide,kit-development|Kit Development,workflows-and-patterns|Workflows & Patterns,troubleshooting-faq|Troubleshooting & FAQ,triple-access-pattern|Triple Access Pattern,edge-deployment|Edge Deployment,adversarial-testing|Adversarial Testing,storage|Storage,licensing|Licensing,docker-and-containers|Docker & Containers,wordpress|WordPress,harness-http-routes|Harness HTTP Routes,sentinel-directory|The .sentinel/ Directory,sentinel-cms|fcms (file CMS),mcp-agent-integration|MCP & Agent Integration,internals|Internals,agentic-ai-operator|Agentic AI Operator,rag-evaluation|RAG Evaluation,ai-provider-extension|AI Provider Extension,content-planes|Content Planes,ndx-trust-soc2|NDX Trust & SOC 2,agentic-ai-uat|Agentic AI UAT" "," -}}
<nav class="docs-nav" aria-label="Documentation">
{{- range $items -}}
{{- $p := split . "|" -}}
{{- $s := index $p 0 -}}
{{- $t := index $p 1 -}}
<a href="/{{$s}}"{{if eq $s $.slug}} class="active" aria-current="page"{{end}}>{{$t}}</a>
{{- end -}}
</nav>
{{end}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{if .post}}{{with index .post.frontmatter "title"}}{{.}} — {{end}}{{end}}Sentinel Docs</title>
  {{if .post}}{{with index .post.frontmatter "description"}}<meta name="description" content="{{.}}">{{end}}{{end}}
  <link rel="stylesheet" href="/kt/sn/docs/pb/style.css">
  <link rel="icon" href="/kt/sn/docs/pb/favicon.ico">
  <script>
  (function () {
    var KEY = "snDocsTheme";
    var BASE = "/kt/sn/docs/pb/themes/";
    var OK = {"terminal-dark":1,"blueprint":1,"paper-ink":1,"high-contrast":1};
    var CHROMA_MAP = {
      "#1f2328": "var(--code-fg)",
      "#57606a": "var(--syntax-comment)",
      "#0550ae": "var(--syntax-operator)",
      "#6639ba": "var(--syntax-keyword)",
      "#cf222e": "var(--syntax-string)",
      "#0a3069": "var(--syntax-string2)",
      "#fff": "var(--code-fg)"
    };
    function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function write(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
    function chromaKey(c) {
      c = String(c || "").replace(/\s+/g, "").toLowerCase();
      var m = c.match(/^rgba?\((\d+),(\d+),(\d+)/);
      if (m) {
        function hx(n) { n = parseInt(n, 10).toString(16); return n.length < 2 ? "0" + n : n; }
        c = "#" + hx(m[1]) + hx(m[2]) + hx(m[3]);
      }
      if (c === "#ffffff") c = "#fff";
      return c;
    }
    function remapChroma() {
      var pres = document.querySelectorAll(".docs-content pre");
      for (var i = 0; i < pres.length; i++) {
        pres[i].style.backgroundColor = "transparent";
        var spans = pres[i].querySelectorAll("span[style]");
        for (var j = 0; j < spans.length; j++) {
          var mapped = CHROMA_MAP[chromaKey(spans[j].style.color)];
          if (mapped) spans[j].style.color = mapped;
        }
      }
    }
    function apply(name) {
      var html = document.documentElement;
      var el = document.getElementById("sn-docs-theme");
      if (!name || name === "default" || !OK[name]) {
        html.removeAttribute("data-theme");
        if (el) el.remove();
        return;
      }
      html.setAttribute("data-theme", name);
      if (!el) {
        el = document.createElement("link");
        el.id = "sn-docs-theme";
        el.rel = "stylesheet";
        var main = document.querySelector('link[href$="pb/style.css"]');
        if (main) main.after(el); else document.head.appendChild(el);
      }
      el.href = BASE + name + ".css";
    }
    var saved = read();
    if (saved) apply(saved);
    document.addEventListener("DOMContentLoaded", function () {
      remapChroma();
      var sel = document.getElementById("theme-picker");
      if (!sel) return;
      sel.value = document.documentElement.getAttribute("data-theme") || "default";
      sel.addEventListener("change", function () { apply(sel.value); write(sel.value); });
    });
  })();
  </script>
</head>
<body>
  <header class="site-header">
    <a class="site-brand" href="/">Sentinel Docs</a>
    <label class="theme-select">
      <span class="theme-select-label">Theme</span>
      <select id="theme-picker" aria-label="Color theme">
        <option value="default">Default Light</option>
        <option value="terminal-dark">Terminal Dark</option>
        <option value="blueprint">Blueprint</option>
        <option value="paper-ink">Paper &amp; Ink</option>
        <option value="high-contrast">High Contrast</option>
      </select>
    </label>
    <a class="site-github" href="https://github.com/ndx-au/sentinel">GitHub</a>
  </header>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      {{template "nav" .}}
    </aside>
    <main class="docs-main">
      <article class="docs-content">
        {{if .post}}{{index .post "full_html" | safeHTML}}{{end}}
      </article>
      {{$items := split "index|Overview,getting-started|Getting Started,api-reference|API Reference,lua-api|Lua API,cli-reference|CLI Reference,configuration-guide|Configuration Guide,kit-development|Kit Development,workflows-and-patterns|Workflows & Patterns,troubleshooting-faq|Troubleshooting & FAQ,triple-access-pattern|Triple Access Pattern,edge-deployment|Edge Deployment,adversarial-testing|Adversarial Testing,storage|Storage,licensing|Licensing,docker-and-containers|Docker & Containers,wordpress|WordPress,harness-http-routes|Harness HTTP Routes,sentinel-directory|The .sentinel/ Directory,sentinel-cms|fcms (file CMS),mcp-agent-integration|MCP & Agent Integration,internals|Internals,agentic-ai-operator|Agentic AI Operator,rag-evaluation|RAG Evaluation,ai-provider-extension|AI Provider Extension,content-planes|Content Planes,ndx-trust-soc2|NDX Trust & SOC 2,agentic-ai-uat|Agentic AI UAT" ","}}
      {{$prevHref := ""}}{{$prevTitle := ""}}{{$nextHref := ""}}{{$nextTitle := ""}}{{$seen := false}}
      {{range $items}}
        {{$p := split . "|"}}
        {{$s := index $p 0}}
        {{$t := index $p 1}}
        {{if $seen}}
          {{if eq $nextHref ""}}{{$nextHref = $s}}{{$nextTitle = $t}}{{end}}
        {{else if eq $s $.slug}}
          {{$seen = true}}
        {{else}}
          {{$prevHref = $s}}{{$prevTitle = $t}}
        {{end}}
      {{end}}
      <nav class="pager" aria-label="Page">
        {{if $prevHref}}<a class="pager-prev" href="/{{$prevHref}}"><span class="pager-label">Previous</span>{{$prevTitle}}</a>{{end}}
        {{if $nextHref}}<a class="pager-next" href="/{{$nextHref}}"><span class="pager-label">Next</span>{{$nextTitle}}</a>{{end}}
      </nav>
    </main>
  </div>
</body>
</html>

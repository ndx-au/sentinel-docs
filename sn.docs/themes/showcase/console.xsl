<xsl:stylesheet version="3.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:import href="common.xsl"/><xsl:output method="html"/><xsl:param name="layout" select="'console'"/><xsl:template match="/"><html lang="en" data-layout="console"><head><xsl:call-template name="head"/></head><body><a class="skip" href="#content">Skip to content</a><header><a class="brand" href="/?view=console">[ SNTL ] OPERATIONS</a><xsl:call-template name="picker"/></header><div class="console-grid"><aside><p class="eyebrow">/ library</p><xsl:call-template name="nav"/></aside><main id="content"><p class="eyebrow">● Knowledge system online</p><h1><xsl:value-of select="document/metadata/field[@name='title']"/></h1><p><xsl:value-of select="document/metadata/field[@name='description']"/></p><div class="console-actions"><button type="button" id="expand-all">Expand all sections</button></div><xsl:for-each-group select="document/content/*" group-starting-with="heading[@level='2']"><xsl:choose><xsl:when test="current-group()[1][self::heading[@level='2']]"><details class="module" open="open" id="{current-group()[1]/@id}"><summary><span class="module-index"><xsl:number value="position()" format="01"/></span><xsl:value-of select="current-group()[1]"/></summary><article><xsl:apply-templates select="current-group()[position() gt 1]"/></article></details></xsl:when><xsl:otherwise><article><xsl:apply-templates select="current-group()[not(self::heading[@level='1'])]"/></article></xsl:otherwise></xsl:choose></xsl:for-each-group></main></div></body></html></xsl:template></xsl:stylesheet>
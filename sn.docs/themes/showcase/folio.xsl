<xsl:stylesheet version="3.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:import href="common.xsl"/><xsl:output method="html"/><xsl:param name="layout" select="'folio'"/><xsl:template match="/"><html lang="en" data-layout="folio"><head><xsl:call-template name="head"/></head><body><a class="skip" href="#content">Skip to content</a><header><a class="brand" href="/?view=folio">Sentinel / Fieldnotes</a><xsl:call-template name="picker"/></header><div class="folio-intro"><p class="eyebrow">Technical field journal · Vol. 01</p><h1><xsl:value-of select="document/metadata/field[@name='title']"/></h1><p><xsl:value-of select="document/metadata/field[@name='description']"/></p><details><summary>Browse the library</summary><xsl:call-template name="nav"/></details></div><main id="content"><xsl:for-each-group select="document/content/*" group-starting-with="heading[@level='2']"><section class="chapter"><div class="chapter-number"><xsl:number value="position()" format="01"/></div><article><xsl:apply-templates select="current-group()[not(self::heading[@level='1'])]"/></article></section></xsl:for-each-group></main><footer><xsl:call-template name="toc"/></footer></body></html></xsl:template></xsl:stylesheet>